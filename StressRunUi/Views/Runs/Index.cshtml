@model QueueRunFormModel

@{
    ViewData["Title"] = "Queue a stress run";
}

<h1>Queue a stress run</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Index" method="post" class="col-md-4">
    <div class="form-group mb-3">
        <label asp-for="ScenarioId" class="control-label"></label>
        <input asp-for="ScenarioId" class="form-control" />
        <span asp-validation-for="ScenarioId" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="RunDate" class="control-label"></label>
        <input asp-for="RunDate" class="form-control" />
        <span asp-validation-for="RunDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Queue run</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
